
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ==========================================
// USER
// ==========================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)

  // Data profil
  telepon      String?  @db.VarChar(20)
  avatar       String?  @db.VarChar(255)

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  peserta      Peserta[]

  @@map("users")
}

// ==========================================
// PESERTA
// ==========================================

model Peserta {
  id           String          @id @default(cuid())
  nik          String          @unique @db.Char(16)
  nama         String
  tanggalLahir DateTime        @map("tanggal_lahir") @db.Date
  jenisKelamin JenisKelamin    @map("jenis_kelamin")
  kategori     KategoriPeserta
  alamat       String          @db.Text
  noTelepon    String?         @map("no_telepon") @db.VarChar(20)

  // Relasi banyak Peserta ke satu User
  userId       String?         @map("user_id")
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Data tambahan peserta
  usiaKehamilan String?        @map("usia_kehamilan") @db.VarChar(50)
  namaWali      String?        @map("nama_wali") @db.VarChar(100)
  noTeleponWali String?        @map("no_telepon_wali") @db.VarChar(20)

  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  // Relasi antrean dan pemeriksaan
  antrean      Antrean[]
  pemeriksaan  Pemeriksaan[]

  @@index([nama])
  @@index([kategori])
  @@index([userId])
  @@map("peserta")
}

// ==========================================
// JADWAL POSYANDU
// ==========================================

model JadwalPosyandu {
  id          String        @id @default(cuid())
  tanggal     DateTime
  lokasi      String
  deskripsi   String?       @db.Text
  status      StatusJadwal  @default(MENDATANG)

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  antrean     Antrean[]
  pemeriksaan Pemeriksaan[]

  @@index([tanggal, status])
  @@map("jadwal_posyandu")
}

// ==========================================
// ANTREAN
// ==========================================

model Antrean {
  id        String         @id @default(cuid())
  noAntrean Int            @map("no_antrean")

  pesertaId String         @map("peserta_id")
  jadwalId  String         @map("jadwal_id")

  status    StatusAntrean  @default(MENUNGGU)
  tanggal   DateTime       @default(now())
  createdAt DateTime       @default(now()) @map("created_at")

  jadwal    JadwalPosyandu @relation(fields: [jadwalId], references: [id], onDelete: Cascade)
  peserta   Peserta        @relation(fields: [pesertaId], references: [id], onDelete: Cascade)

  @@unique([jadwalId, noAntrean])
  @@unique([jadwalId, pesertaId])
  @@index([jadwalId, status, noAntrean])
  @@index([pesertaId], map: "antrean_peserta_id_fkey")
  @@map("antrean")
}

// ==========================================
// PEMERIKSAAN
// ==========================================

model Pemeriksaan {
  id                 String            @id @default(cuid())

  pesertaId          String            @map("peserta_id")
  jadwalId           String            @map("jadwal_id")

  tanggalPemeriksaan DateTime          @default(now()) @map("tanggal_pemeriksaan")

  tinggiBadan        Decimal?          @map("tinggi_badan") @db.Decimal(5, 2)
  beratBadan         Decimal?          @map("berat_badan") @db.Decimal(5, 2)
  lingkarKepala      Decimal?          @map("lingkar_kepala") @db.Decimal(5, 2)

  catatan            String?           @db.Text

  statusPemeriksaan  StatusPemeriksaan @default(BELUM_DIPERIKSA) @map("status_pemeriksaan")

  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  jadwal             JadwalPosyandu    @relation(fields: [jadwalId], references: [id], onDelete: Cascade)
  peserta            Peserta           @relation(fields: [pesertaId], references: [id], onDelete: Cascade)

  @@unique([pesertaId, jadwalId])
  @@index([tanggalPemeriksaan, statusPemeriksaan])
  @@index([jadwalId], map: "pemeriksaan_jadwal_id_fkey")
  @@map("pemeriksaan")
}

// ==========================================
// ENUM ROLE
// ==========================================

enum Role {
  ADMIN
  KADER
  USER
}

// ==========================================
// ENUM JENIS KELAMIN
// ==========================================

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

// ==========================================
// ENUM KATEGORI PESERTA
// ==========================================

enum KategoriPeserta {
  BALITA
  IBU_HAMIL
  LANSIA
}

// ==========================================
// ENUM STATUS JADWAL
// ==========================================

enum StatusJadwal {
  MENDATANG
  BERJALAN
  SELESAI
}

// ==========================================
// ENUM STATUS ANTREAN
// ==========================================

enum StatusAntrean {
  MENUNGGU
  DIPERIKSA
  SELESAI
  BATAL
}

// ==========================================
// ENUM STATUS PEMERIKSAAN
// ==========================================

enum StatusPemeriksaan {
  SELESAI
  BELUM_DIPERIKSA
}
